# Enable or disable the GraphQL endpoint (/api/graphql). Set to true to enable.
MATOI_GRAPHQL=true

# The port on which the Matoi API server will run.
MATOI_PORT=3000

# Connection string for the Redis cache server (e.g., redis://user:pass@host:port). Required for caching provider responses.
MATOI_REDIS_URL=

# Cache expiration time (Time to Live) in minutes for Redis cache entries.
MATOI_REDIS_EXPIRE_CACHE=1

# The base URL used by the media proxy to build absolute URLs. Leave empty to auto-detect from the request.
MATOI_RESOLVER_URL=

# Custom User-Agent header sent to upstream imageboard APIs to identify this application.
MATOI_USER_AGENT="matoi/15.0.0-alpha Go/1.26.4"

# Enable or disable request logging in the console.
MATOI_ENABLE_LOGS=true

# Global API Key required to access protected Matoi endpoints (passed via ?api_key= or Authorization: Bearer).
MATOI_API_KEY=matoi

# The maximum number of posts returned per page across all provider REST endpoints (except Realbooru).
MATOI_POST_REST_RETURN_LIMIT=100

# FlareSolverr URL used to bypass Cloudflare protection for blocked providers
# https://github.com/sinkaroid/matoi/pkgs/container/matoi-flaresolverr
# Set to http://localhost:8191/v1 if running locally, or your VPS URL.
MATOI_FLARESOLVERR_URL=

# ==========================================
# Provider API Keys & Authentication
# ==========================================

# Rule34 user ID for authentication (optional, increases rate limits).
RULE34_API_ID=AAA
# Rule34 API key for authentication (optional, increases rate limits).
RULE34_API_KEY=XXX

# Danbooru username/login for authentication.
DANBOORU_API_ID=AAA
# Danbooru API key. Required to access certain content and bypass strict limits.
DANBOORU_API_KEY=XXX

# Gelbooru user ID for authentication.
GELBOORU_API_ID=AAA
# Gelbooru API key to increase rate limits.
GELBOORU_API_KEY=XXX

# E621 username for authentication.
E621_API_ID=AAA
# E621 API key. E621 strictly limits unauthenticated requests.
E621_API_KEY=XXX

# E926 username for authentication.
E926_API_ID=AAA
# E926 API key. E926 strictly limits unauthenticated requests.
E926_API_KEY=XXXX

# Furbooru API key for authentication and bypassing limits.
FURBOORU_API_KEY=XXX

# Derpibooru API key for authentication and bypassing limits.
DERPIBOORU_API_KEY=XXX
